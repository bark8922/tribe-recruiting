table 'WBR Client History'
	lineageTag: db49cbba-0030-40c8-8c41-5e898d9bb62d

	measure 'Contacted Target Reached %' = ```
			var con = CALCULATE(COUNT('WBR Client History'[Week start end]), 'WBR Client History'[Contacted Reached]="Reached")+0
			var wee = DISTINCTCOUNT('WBR Client History'[Week start end]) 
			RETURN
			con/wee
			```
		formatString: 0%;-0%;0%
		lineageTag: 569f5460-9f0c-46d3-965a-e72fe3e841f6

	measure 'Screens Target Reached %' = ```
			var scr = CALCULATE(COUNT('WBR Client History'[Week start end]), 'WBR Client History'[Screens Reached]="Reached")+0
			var wee = DISTINCTCOUNT('WBR Client History'[Week start end]) 
			RETURN
			scr/wee
			```
		formatString: 0%;-0%;0%
		lineageTag: 22a28db7-5f49-4fe9-b826-17bdc0152b4e

