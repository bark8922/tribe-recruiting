				    event[who_event_created_for],
				    "# Jobs", DISTINCTCOUNT(job[job_id])
				    ),
				    client[client_name]<>"Tribe.xyz", client[client_name]<>BLANK(), event[date_created]>=DATE(2025,7,28), candidate[is_candidate_archived]=FALSE())

