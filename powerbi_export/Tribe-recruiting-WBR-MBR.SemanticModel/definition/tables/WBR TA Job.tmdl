table 'WBR TA Job'
	lineageTag: dbef0171-2658-42ca-8f7e-bd7092b402bb

	measure 'Actual screen to ATS %' = DIVIDE(SUM('WBR TA Job'[Moved to ATS]), SUM('WBR TA Job'[Actual screens]))
