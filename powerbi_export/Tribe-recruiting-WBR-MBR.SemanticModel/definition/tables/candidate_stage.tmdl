	column 'Diff Concated - Job created' =
			var d = DATEDIFF(RELATED(job[date_created]), candidate_stage[date_contacted], DAY)
			RETURN IF(d<0, BLANK(), d)
		formatString: 0
		lineageTag: 5b832ab5-f4b8-42de-b976-e109804a272f
