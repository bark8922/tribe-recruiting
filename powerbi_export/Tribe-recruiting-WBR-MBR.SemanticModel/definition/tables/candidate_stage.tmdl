	column 'Contacted created diff' = IF(candidate_stage[date_contacted]=candidate_stage[date_created], TRUE(), FALSE())
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 0d77a899-3300-4ce4-8718-ca6fb0abda64
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Last update' = MAX(MAX(MAX(MAX(MAX(MAX(MAX(candidate_stage[date_created], candidate_stage[date_lnkdin_viewed]), candidate_stage[date_contacted]), candidate_stage[date_screen]), candidate_stage[date_screen_actual]), candidate_stage[date_interview]), candidate_stage[date_offer]), candidate_stage[date_hired])
		formatString: yyyy-mm-dd
		lineageTag: 7bb18176-3fb8-4da0-8ad4-aac456b1615e
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column 'Is First Hired?' =
			SWITCH(TRUE(),
			candidate_stage[hired_order]=1, "Yes",
			candidate_stage[hired_order]<>1 && MOD(candidate_stage[hired_order],10)=1, CONVERT(candidate_stage[hired_order],STRING)&"st",
			candidate_stage[hired_order]<>1 && MOD(candidate_stage[hired_order],10)=2, CONVERT(candidate_stage[hired_order],STRING)&"nd",
			candidate_stage[hired_order]<>1 && MOD(candidate_stage[hired_order],10)=3, CONVERT(candidate_stage[hired_order],STRING)&"rd",
			CONVERT(candidate_stage[hired_order],STRING)&"th")
		lineageTag: 950fe1b7-1c9f-465d-bdd8-66382ca2d5be
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

