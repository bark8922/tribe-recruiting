	column '# ATS' = CALCULATE(COUNT(candidate_stage[candidate_id]), candidate_stage[date_interview]<>BLANK())
		formatString: 0
		lineageTag: 1005661d-5125-49d3-81af-01293dcbc5fb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Early warning' =
			var ats = IF(job[Job Days Opened]>=28 && job[# ATS]=BLANK(), 1, 0)
			var offer = IF(job[# Actual Screens]>=25 && job[# Offers]=BLANK(), 1, 0)
			var hire = IF(job[Job Days Opened]>=60 && job[date_first_hired]=BLANK(), 1, 0)
			RETURN IF(ats=1 || offer=1 || hire=1, 1, 0)
		formatString: 0
		lineageTag: dee230bf-8e95-4396-b659-d78f4fc9ced5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '# Offers' = CALCULATE(COUNT(candidate_stage[candidate_id]), candidate_stage[date_offer]<>BLANK())
