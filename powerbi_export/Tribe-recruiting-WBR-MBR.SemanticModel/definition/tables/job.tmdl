table job
	lineageTag: a7dfb17c-1f9f-4cba-8a22-e0689eca880b

	measure '# Job (time to hire)' = CALCULATE(COUNT(job[job_id]), job[date_first_hired]<>BLANK(), job[Diff Hired - Job created]>=0)
		formatString: 0
		lineageTag: 70c31bb6-c0e8-41d6-aed1-8f11d4e708fa

		changedProperty = IsHidden

	measure 'Job Creation between' = ```
			"From " & FORMAT(MIN(job[date_created]), "YYYY-MM-DD") & " until " & FORMAT(MAX(job[date_created]), "YYYY-MM-DD") 
			```
		lineageTag: c2dee24c-6852-4c37-ae62-a5cde24640ca

		changedProperty = IsHidden

	measure '0-30 days' = CALCULATE(COUNT(job[job_id]), job[Job Days Opened]<=30)
		formatString: 0
		lineageTag: e5251161-df35-4fd2-ada8-22cdc997606c

	measure '30-60 days' = CALCULATE(COUNT(job[job_id]), job[Job Days Opened]>30 && job[Job Days Opened]<=60)
		formatString: 0
		lineageTag: b289ad8e-c262-4459-b5ef-33cc05a3e27c

	measure '> 60 days' = CALCULATE(COUNT(job[job_id]), job[Job Days Opened]>60)
		formatString: 0
		lineageTag: 62935d5d-a95e-4f3d-83dc-bac41e0d4de1

	measure 'Total Active Pipelines' = CALCULATE(DISTINCTCOUNT(job[job_id]), REMOVEFILTERS(job[Problem jobs]))
		formatString: 0
		lineageTag: 7dd90914-0691-40ee-94e0-4883d7a0cace

	measure 'Problem Pipelines %' =
			DIVIDE(
			    CALCULATE(DISTINCTCOUNT(job[job_id]), job[Problem jobs]=1),
			    [Total Active Pipelines])
		formatString: 0%;-0%;0%
		lineageTag: 214da02c-f645-4d01-8507-198e3359fd24

	measure '# Problem jobs' = CALCULATE(COUNT(job[job_id]), job[Problem jobs]=1)
		formatString: 0
		lineageTag: c6d0329b-3899-43a5-ace2-d43e0d23f8e1

	measure '# Total Jobs for calculaing problem jobs' = CALCULATE(COUNT(job[job_id]), job[# ATS]>2)
		formatString: 0
		lineageTag: 4588f39d-8ceb-4001-a319-de9e6f72e296

	measure '% Problem Jobs' = DIVIDE([# Problem jobs], [# Total Jobs for calculaing problem jobs])
		formatString: 0%;-0%;0%
		lineageTag: 2cb20172-184f-4cf2-90dd-1bb92aea9214

	measure '60-90 days' = CALCULATE(COUNT(job[job_id]), job[Job Days Opened]>60 && job[Job Days Opened]<=90)
		formatString: 0
		lineageTag: 5f3d385f-eae5-444e-b468-fd2f21b7d7fe

	measure '>90 days' = CALCULATE(COUNT(job[job_id]), job[Job Days Opened]>90)
		formatString: 0
		lineageTag: dd39af9d-9bd4-4345-b435-363e0d54dbc9

