    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nif (!items.length) return [{ json: { csv: '' } }];\nconst keys = Object.keys(items[0].json);\nconst header = keys.join(',');\nconst rows = items.map(item => keys.map(k => {\n  let v = String(item.json[k] == null ? '' : item.json[k]);\n  if (v.includes(',') || v.includes('\"') || v.includes('\\n')) v = '\"' + v.replace(/\"/g, '\"\"') + '\"';\n  return v;\n}).join(',')).join('\\n');\nreturn [{ json: { csv: header + '\\n' + rows } }];"
      },
